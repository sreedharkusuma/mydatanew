<?xml version="1.0"?>
<configuration>
<startup>
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/>
</startup>
  <system.net>
    <defaultProxy useDefaultCredentials="true"/>
  </system.net>

  <appSettings>
    <add key="CLOUD_URL" value="https://cloudapi.acemf.in/clouddata/"/>
    <add key="CLOUD_DURL" value="https://cloudapi.acemf.in/CloudDownload/"/>
  </appSettings>
</configuration>
